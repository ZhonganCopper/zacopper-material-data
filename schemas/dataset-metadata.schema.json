{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZA Copper dataset metadata",
  "type": "object",
  "required": ["id", "title", "product", "sourceType", "revision", "publishedAt", "limitations", "officialSource"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "product": {
      "type": "object",
      "required": ["slug"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "grade": { "type": "string" }
      }
    },
    "sourceType": {
      "enum": ["instrument-export", "laboratory-report", "calculated", "digitized-chart", "representative-example", "lot-specific"]
    },
    "revision": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string", "format": "date" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "officialSource": { "type": "string", "format": "uri", "const": "https://www.zacopper.com/" }
  }
}
